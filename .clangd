# clangd uses macOS Apple clang, which doesn't recognize xtensa-specific flags.
# These flags only matter when cross-compiling with idf.py, not for indexing.

CompileFlags:
  # build/gen holds the generated app_version.h (CARVISTON_VERSION); it exists
  # after the first `idf.py build`. Add it so the editor resolves the include.
  Add:
    - -Ibuild/gen
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=*
    - -fno-malloc-dce
    - -march=*

Diagnostics:
  Suppress:
    - drv_unknown_argument
    - drv_unknown_argument_with_suggestion
    - pp_file_not_found
    - unused-includes
